@page "/recipes"

@inject HttpClient Http

@if (recipes == null)
{
    <MudProgressCircular Indeterminate="true"/>
}
else
{
    <MudSimpleTable>
        <thead>
            <tr><th>Recipe</th></tr>
        </thead>
        <tbody>
            @foreach (var recipe in recipes)
            {
                <tr><td><MudLink Href="@($"recipes/{recipe.Id}")">@recipe.Name</MudLink></td></tr>
            }
        </tbody>
    </MudSimpleTable>
}
<MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="recipes/new" Size="Size.Large" Class="fab-botton-right"/>

@code {
    private List<Recipe>? recipes;

    protected override async Task OnInitializedAsync()
    {
        recipes = await Http.GetFromJsonAsync<List<Recipe>>("api/recipes");
    }
    
}