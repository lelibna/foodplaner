@inject HttpClient Http

@if (recipe == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4">@recipe.Name</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Portions: @recipe.Portions</MudText>

    <div class="recipe-layout">
        <section class="recipe-ingredients">
            <MudText Typo="Typo.h6" Class="mb-2">Ingredients</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th style="text-align: right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingredient in recipe.Ingredients)
                    {
                        <tr>
                            <td>@ingredient.Name</td>
                            <td style="text-align: right;">@ingredient.Amount @ingredient.Unit</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </section>

        <section class="recipe-instructions">
            <MudText Typo="Typo.h6" Class="mb-2">Instructions</MudText>
            @if (string.IsNullOrWhiteSpace(recipe.Instructions))
            {
                <MudText Class="mud-text-secondary">No instructions yet.</MudText>
            }
            else
            {
                <MudText Class="recipe-instructions-text">@recipe.Instructions</MudText>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id {get; set;}
    private RecipeDetailTransfer? recipe;
    protected override async Task OnParametersSetAsync()
    {
        recipe = await Http.GetFromJsonAsync<RecipeDetailTransfer>($"api/recipes/{Id}");
    }
}